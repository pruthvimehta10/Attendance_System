# Production Environment Variables
# Copy this file to .env and fill in your actual values

# Security
SECRET_KEY=your-very-secure-random-string-here-min-32-chars
FLASK_ENV=production

# Database Configuration
# PostgreSQL (Recommended for production)
DATABASE_URL=postgresql://username:password@host:5432/attendance_db

# Alternative: MySQL
# DATABASE_URL=mysql://username:password@host:3306/attendance_db

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Cloud Storage (Optional - for QR code images)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# Redis (Optional - for session storage and caching)
REDIS_URL=redis://username:password@host:6379/0

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# Email (Optional - for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/attendance/app.log

# CORS (Optional - if using separate frontend)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting (Optional)
RATELIMIT_STORAGE_URL=redis://localhost:6379
